{
  "openapi": "3.0.0",
  "info": {
    "title": "Tumble API",
    "description": "API for the Tumble content application",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Local Server"
    }
  ],
  "paths": {
    "/irclink/": {
      "get": {
        "summary": "Redirect to an IRC Link",
        "description": "Redirects to the URL associated with the given ID.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "The ID of the link to redirect to (can also be passed as the entire query string, e.g. /irclink/?123)",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to the target URL"
          },
          "404": {
            "description": "Link not found"
          },
          "400": {
            "description": "Invalid ID"
          }
        }
      },
      "post": {
        "summary": "Submit a new IRC Link",
        "description": "Submits a new link. Links are always added even if duplicates exist. Returns different status codes and contextual information about previous submissions when duplicates are detected.",
        "parameters": [
          {
            "name": "user",
            "in": "query",
            "description": "The username of the submitter",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "description": "The URL to submit",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "description": "Source of submission. 'irc' returns plain text ID with duplicate marker. 'api' or Accept: application/json returns JSON with duplicate context.",
            "schema": {
              "type": "string",
              "enum": [
                "irc",
                "api",
                "web"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Link created successfully (HTML response)",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string",
                  "description": "HTML redirect page with optional duplicate notification"
                }
              }
            }
          },
          "201": {
            "description": "New link created successfully (JSON response)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "link_id": {
                      "type": "integer",
                      "description": "ID of the newly created link"
                    },
                    "is_duplicate": {
                      "type": "boolean",
                      "description": "Always false for 201 responses"
                    },
                    "previous_submissions": {
                      "type": "array",
                      "description": "Empty for new links",
                      "items": {
                        "type": "object"
                      }
                    }
                  },
                  "example": {
                    "link_id": 123,
                    "is_duplicate": false,
                    "previous_submissions": []
                  }
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "123",
                  "description": "Link ID (IRC source)"
                }
              }
            }
          },
          "208": {
            "description": "Link already reported - duplicate detected (JSON response)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "link_id": {
                      "type": "integer",
                      "description": "ID of the newly created link"
                    },
                    "is_duplicate": {
                      "type": "boolean",
                      "description": "Always true for 208 responses"
                    },
                    "previous_submissions": {
                      "type": "array",
                      "description": "List of all previous submissions of this URL",
                      "items": {
                        "type": "object",
                        "properties": {
                          "link_id": {
                            "type": "integer",
                            "description": "ID of the previous submission"
                          },
                          "user": {
                            "type": "string",
                            "description": "Username who submitted previously"
                          },
                          "timestamp": {
                            "type": "string",
                            "format": "date-time",
                            "description": "When the link was previously submitted"
                          },
                          "title": {
                            "type": "string",
                            "description": "Title of the previous submission"
                          }
                        }
                      }
                    }
                  },
                  "example": {
                    "link_id": 456,
                    "is_duplicate": true,
                    "previous_submissions": [
                      {
                        "link_id": 123,
                        "user": "alice",
                        "timestamp": "2026-01-15T10:30:00Z",
                        "title": "Example Page"
                      }
                    ]
                  }
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "456 (duplicate, previously posted by alice)",
                  "description": "Link ID with duplicate marker (IRC source)"
                }
              }
            }
          },
          "500": {
            "description": "Server Error"
          }
        }
      },
      "delete": {
        "summary": "Delete an IRC link",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
            "200": {
                "description": "Link deleted successfully"
            },
            "404": {
                "description": "Link not found"
            }
        }
      }
    },
    "/api/caching/invalidate": {
      "get": {
        "summary": "Invalidate Link Preview Cache",
        "description": "Removes a URL from the server-side link preview cache.",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "description": "The URL to invalidate",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cache Invalidated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing URL"
          }
        }
      }
    },
    "/ogpreview": {
      "get": {
        "summary": "Get OpenGraph Preview",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OpenGraph Metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "title": { "type": "string" },
                    "description": { "type": "string" },
                    "image": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/quote/": {
      "get": {
        "summary": "Get a Random Quote",
        "responses": {
          "200": {
            "description": "Random Quote",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "Wise words -- Author"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "quoteID": { "type": "integer" },
                    "timestamp": { "type": "string", "format": "date-time" },
                    "quote": { "type": "string" },
                    "author": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Submit a Quote",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "quote": { "type": "string" },
                  "author": { "type": "string" }
                },
                "required": ["quote", "author"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quote created",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "1"
                }
              }
            }
          },
          "400": {
            "description": "Missing inputs"
          }
        }
      }
    },
    "/search": {
      "get": {
        "summary": "Search Content",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 4
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search Results HTML",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/stats": {
      "get": {
        "summary": "Get User Statistics",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sort order (default: links)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Statistics HTML Page",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
