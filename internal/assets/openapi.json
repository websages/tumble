{
  "openapi": "3.0.0",
  "info": {
    "title": "Tumble API",
    "description": "API for the Tumble content application",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Local Server"
    }
  ],
  "paths": {
    "/irclink/": {
      "get": {
        "summary": "Redirect to an IRC Link",
        "description": "Redirects to the URL associated with the given ID.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "The ID of the link to redirect to (can also be passed as the entire query string, e.g. /irclink/?123)",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to the target URL"
          },
          "404": {
            "description": "Link not found"
          },
          "400": {
            "description": "Invalid ID"
          }
        }
      },
      "post": {
        "summary": "Submit a new IRC Link",
        "parameters": [
          {
            "name": "user",
            "in": "query",
            "description": "The username of the submitter",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "description": "The URL to submit",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "description": "Source of submission. If 'irc', returns raw ID.",
            "schema": {
              "type": "string",
              "enum": [
                "irc",
                "web"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Link created successfully",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "123"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Server Error"
          }
        }
      }
    },
    "/ogpreview.cgi": {
      "get": {
        "summary": "Get OpenGraph Preview",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OpenGraph Metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "title": { "type": "string" },
                    "description": { "type": "string" },
                    "image": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/quote/": {
      "post": {
        "summary": "Submit a Quote",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "quote": { "type": "string" },
                  "author": { "type": "string" }
                },
                "required": ["quote", "author"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quote created",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "1"
                }
              }
            }
          },
          "400": {
            "description": "Missing inputs"
          }
        }
      }
    },
    "/search.cgi": {
      "get": {
        "summary": "Search Content",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 4
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search Results HTML",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
