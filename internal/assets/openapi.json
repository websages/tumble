{
  "openapi": "3.0.0",
  "info": {
    "title": "Tumble API",
    "description": "API for the Tumble content application. Note: API endpoints use 308 (Permanent Redirect) instead of 301 for trailing slash redirects on POST/PUT/DELETE requests to preserve the HTTP method.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Local Server"
    }
  ],
  "paths": {
    "/api/caching/invalidate": {
      "get": {
        "summary": "Invalidate Link Preview Cache",
        "description": "Removes a URL from the server-side link preview cache.",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "description": "The URL to invalidate",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cache Invalidated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing URL"
          }
        }
      }
    },
    "/link/": {
      "post": {
        "summary": "Submit a new Link",
        "description": "Submits a new link. Links are always added even if duplicates exist. Returns different status codes and contextual information about previous submissions when duplicates are detected.",
        "parameters": [
          {
            "name": "user",
            "in": "query",
            "description": "The username of the submitter",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "description": "The URL to submit",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "description": "Source of submission. 'irc' returns plain text ID with duplicate marker. 'api' or Accept: application/json returns JSON with duplicate context.",
            "schema": {
              "type": "string",
              "enum": [
                "irc",
                "api",
                "web"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Link created successfully (HTML response)",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string",
                  "description": "HTML redirect page with optional duplicate notification"
                }
              }
            }
          },
          "201": {
            "description": "New link created successfully (JSON response)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "link_id": {
                      "type": "integer",
                      "description": "ID of the newly created link"
                    },
                    "is_duplicate": {
                      "type": "boolean",
                      "description": "Always false for 201 responses"
                    },
                    "previous_submissions": {
                      "type": "array",
                      "description": "Empty for new links",
                      "items": {
                        "type": "object"
                      }
                    }
                  },
                  "example": {
                    "link_id": 123,
                    "is_duplicate": false,
                    "previous_submissions": []
                  }
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "123",
                  "description": "Link ID (IRC source)"
                }
              }
            }
          },
          "208": {
            "description": "Link already reported - duplicate detected (JSON response)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "link_id": {
                      "type": "integer",
                      "description": "ID of the newly created link"
                    },
                    "is_duplicate": {
                      "type": "boolean",
                      "description": "Always true for 208 responses"
                    },
                    "previous_submissions": {
                      "type": "array",
                      "description": "List of all previous submissions of this URL",
                      "items": {
                        "type": "object",
                        "properties": {
                          "link_id": {
                            "type": "integer",
                            "description": "ID of the previous submission"
                          },
                          "user": {
                            "type": "string",
                            "description": "Username who submitted previously"
                          },
                          "timestamp": {
                            "type": "string",
                            "format": "date-time",
                            "description": "When the link was previously submitted"
                          },
                          "title": {
                            "type": "string",
                            "description": "Title of the previous submission"
                          }
                        }
                      }
                    }
                  },
                  "example": {
                    "link_id": 456,
                    "is_duplicate": true,
                    "previous_submissions": [
                      {
                        "link_id": 123,
                        "user": "alice",
                        "timestamp": "2026-01-15T10:30:00Z",
                        "title": "Example Page"
                      }
                    ]
                  }
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "456 (duplicate, previously posted by alice)",
                  "description": "Link ID with duplicate marker (IRC source)"
                }
              }
            }
          },
          "308": {
            "description": "Permanent redirect (preserves POST method) - occurs when trailing slash is missing from URL"
          },
          "500": {
            "description": "Server Error"
          }
        }
      }
    },
    "/link/{id}": {
      "get": {
        "summary": "Redirect to a Link",
        "description": "Redirects to the URL associated with the given ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The ID of the link to redirect to",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sig",
            "in": "query",
            "description": "Click signature for verified click tracking",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to the target URL"
          },
          "404": {
            "description": "Link not found"
          },
          "400": {
            "description": "Invalid ID"
          }
        }
      },
      "delete": {
        "summary": "Delete a link",
        "description": "Deletes a link by ID. Requires admin authentication via X-Admin-Secret header or secret query parameter.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The ID of the link to delete",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
            "200": {
                "description": "Link deleted successfully"
            },
            "308": {
                "description": "Permanent redirect (preserves DELETE method) - occurs when trailing slash is missing"
            },
            "403": {
                "description": "Forbidden - invalid or missing admin secret"
            },
            "404": {
                "description": "Link not found"
            }
        }
      }
    },
    "/link/{id}.json": {
      "get": {
        "summary": "Get Link Metadata",
        "description": "Returns the full link metadata as JSON, including the owner (user), title, URL, click count, and timestamp.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The ID of the link",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Link metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ircLinkID": {
                      "type": "integer",
                      "description": "The unique link ID"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time",
                      "description": "When the link was submitted"
                    },
                    "user": {
                      "type": "string",
                      "description": "The username who submitted the link"
                    },
                    "title": {
                      "type": "string",
                      "description": "The title of the linked page"
                    },
                    "url": {
                      "type": "string",
                      "description": "The target URL"
                    },
                    "clicks": {
                      "type": "integer",
                      "description": "Number of verified clicks"
                    },
                    "content_type": {
                      "type": "string",
                      "description": "Content type hint (e.g., 'image' for images)"
                    }
                  },
                  "example": {
                    "ircLinkID": 42,
                    "timestamp": "2026-01-15T10:30:00Z",
                    "user": "alice",
                    "title": "Example Article",
                    "url": "http://example.com/article",
                    "clicks": 15,
                    "content_type": "0"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Link not found"
          },
          "400": {
            "description": "Invalid ID"
          }
        }
      }
    },
    "/ogpreview": {
      "get": {
        "summary": "Get OpenGraph Preview",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OpenGraph Metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "title": { "type": "string" },
                    "description": { "type": "string" },
                    "image": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/quote/": {
      "get": {
        "summary": "Get a Random Quote",
        "responses": {
          "200": {
            "description": "Random Quote",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "Wise words -- Author"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "quoteID": { "type": "integer" },
                    "timestamp": { "type": "string", "format": "date-time" },
                    "quote": { "type": "string" },
                    "author": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Submit a Quote",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "quote": { "type": "string" },
                  "author": { "type": "string" }
                },
                "required": ["quote", "author"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quote created",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "http://example.com/quote/42",
                  "description": "Permalink URL to the newly created quote"
                }
              }
            }
          },
          "308": {
            "description": "Permanent redirect (preserves POST method) - occurs when trailing slash is missing from URL"
          },
          "400": {
            "description": "Missing inputs"
          }
        }
      }
    },
    "/quote/{id}": {
      "get": {
        "summary": "Get Quote by ID (Permalink)",
        "description": "Returns a specific quote by ID. Defaults to HTML page for browser visits, or returns JSON with Accept: application/json header.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The ID of the quote",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Quote found",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string",
                  "description": "HTML page displaying the quote"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "quoteID": {
                      "type": "integer",
                      "description": "The unique quote ID"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time",
                      "description": "When the quote was submitted"
                    },
                    "quote": {
                      "type": "string",
                      "description": "The quote text"
                    },
                    "author": {
                      "type": "string",
                      "description": "The author of the quote"
                    }
                  },
                  "example": {
                    "quoteID": 42,
                    "timestamp": "2026-01-15T10:30:00Z",
                    "quote": "The only way to do great work is to love what you do.",
                    "author": "Steve Jobs"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Quote not found"
          },
          "400": {
            "description": "Invalid ID"
          }
        }
      },
      "delete": {
        "summary": "Delete a quote",
        "description": "Deletes a quote by ID. Requires admin authentication via X-Admin-Secret header or secret query parameter.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The ID of the quote to delete",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Quote deleted successfully"
          },
          "308": {
            "description": "Permanent redirect (preserves DELETE method) - occurs when trailing slash is missing"
          },
          "403": {
            "description": "Forbidden - invalid or missing admin secret"
          },
          "404": {
            "description": "Quote not found"
          }
        }
      }
    },
    "/quote/{id}.json": {
      "get": {
        "summary": "Get Quote Metadata as JSON",
        "description": "Returns the quote as JSON, regardless of Accept header.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The ID of the quote",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Quote metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "quoteID": {
                      "type": "integer",
                      "description": "The unique quote ID"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time",
                      "description": "When the quote was submitted"
                    },
                    "quote": {
                      "type": "string",
                      "description": "The quote text"
                    },
                    "author": {
                      "type": "string",
                      "description": "The author of the quote"
                    }
                  },
                  "example": {
                    "quoteID": 42,
                    "timestamp": "2026-01-15T10:30:00Z",
                    "quote": "The only way to do great work is to love what you do.",
                    "author": "Steve Jobs"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Quote not found"
          },
          "400": {
            "description": "Invalid ID"
          }
        }
      }
    },
    "/search": {
      "get": {
        "summary": "Search Content",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 4
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search Results HTML",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/stats": {
      "get": {
        "summary": "Get User Statistics",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sort order (default: links)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Statistics HTML Page",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/stats.json": {
      "get": {
        "summary": "Get User Statistics as JSON",
        "description": "Returns user statistics including link and quote counts for each user, sorted by link count descending. Supports pagination.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of results to return (default: 50, max: 1000)",
            "schema": {
              "type": "integer",
              "default": 50,
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of results to skip (default: 0)",
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of user statistics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "user": {
                        "type": "string",
                        "description": "The username"
                      },
                      "link_count": {
                        "type": "integer",
                        "description": "Number of links submitted by this user"
                      },
                      "quote_count": {
                        "type": "integer",
                        "description": "Number of quotes submitted by this user"
                      }
                    }
                  },
                  "example": [
                    {
                      "user": "alice",
                      "link_count": 150,
                      "quote_count": 42
                    },
                    {
                      "user": "bob",
                      "link_count": 120,
                      "quote_count": 35
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Server Error"
          }
        }
      }
    }
  }
}
